# 真实 LLM 接入配置模板
# 复制为 .env 并填写真实值（.env 已被 .gitignore，不会提交到仓库）
#
# 获取方式：MiniMax 开放平台创建 API key
# 支持任意 OpenAI 兼容端点（改 LLM_BASE_URL 即可）
#
# 配置后用「洪荒 探针」体检连通性：发 1 token 最小请求验证
# key/端点/模型/网络全链路，失败时给出分档修复指引。

LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1/chat/completions
LLM_MODEL=MiniMax-M3

# 可选：单次 LLM 调用超时（毫秒，默认 120000，8000 token 输出窗口需要足够大）
# LLM_TIMEOUT_MS=120000

# 可选：关闭流水线实时进度输出（stderr）
# LLM_PROGRESS=off
